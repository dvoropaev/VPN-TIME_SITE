                a(href="https://www.ozon.ru/product/kovrik-dlya-myshki-3814789902/" class="btn btn-green" target="_blank")
                  span.text купить большой коврик на ozon
              div
                a(href="https://www.ozon.ru/product/kovrik-dlya-myshki-3887054007/" class="btn btn-green" target="_blank")
                  span.text купить маленький коврик на ozon

