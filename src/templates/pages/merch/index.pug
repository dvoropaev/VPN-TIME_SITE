extends ../../layouts/_layout.pug

block vars
  - var basePath = '/'
  - var bodyClass = 'page-merch'
  - var currentPage = 'merch'
  - var canonicalPath = '/merch/'

block title
  title merch

block content
  main
    .cloud-mini__left-1
    .cloud-mini__left-2

    .cloud-mini__right-1
    .cloud-mini__right-2

    .content
      section.hero
        .hero__bg-trees
        .container
          .hero__image

      .container
        .home__info
          .home__info-wrapper
            .home__info-content
              .cards 
                .card.merch__img-1 
                  img(src="/img/page/merch/merch-1.jpg", alt="магнит VPN-TIME")
                .card.merch__img-2
                  img(src="/img/page/merch/merch-2.jpg", alt="магнит VPN-TIME")
              p Магнит "VPN-TIME", акриловый, прямоугольный, 5x7см
              p Мы выпустили первый мерч VPN-TIME —  оберег от роскомнадзора акриловый магнит с фирменными персонажами!
              p -
              p Он отлично смотрится на холодильнике, компьютере или любой металлической поверхности 😎
              p 🎁 А на обратной стороне — промокод на 100 часов VPN в подарок!
              div
                a(href="https://www.ozon.ru/search/?deny_category_prediction=true&from_global=true&text=%D0%9C%D0%B0%D0%B3%D0%BD%D0%B8%D1%82+%D0%BD%D0%B0+%D1%85%D0%BE%D0%BB%D0%BE%D0%B4%D0%B8%D0%BB%D1%8C%D0%BD%D0%B8%D0%BA&product_id=2545000968" class="btn btn-green" target="_blank")
                  span.text купить на ozon
              div
                a(href="#" class="btn btn-green")
                  span.text купить на Wildberries
              div
                a(href="#" class="btn btn-green")
                  span.text купить на Яндекс Маркете

