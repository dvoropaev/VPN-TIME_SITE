      .box__btn
        a(href="tg://resolve?domain=vpn_time_support" onclick="setTimeout(() => { window.location.href='https://t.me/vpn_time_support'; }, 500);" class="btn btn-blue" target="_blank")
          span.icon.icon-telegram
          .text связаться с нами
