extends ../../../layouts/_layout.pug

block vars
  - var basePath = '/'
  - var bodyClass = 'page-instructions'
  - var currentPage = 'instructions'
  - var canonicalPath = '/instructions/open-vpn/'

block structuredData
  script(type='application/ld+json').
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": "Инструкции OpenVPN",
      "url": "https://vtime.pro/instructions/open-vpn/",
      "description": "Выбор инструкций по настройке OpenVPN для Windows, macOS, iPhone, Android и других устройств.",
      "inLanguage": "ru-RU",
      "about": {
        "@type": "SoftwareApplication",
        "name": "OpenVPN Connect"
      }
    }

block title
  title Инструкции OpenVPN

block content
  main
    .content
      section.instructions-hero
        .hero__bg-trees
        .hero__bg-server
        .container
          .instructions-hero__image


      .container

        .instructions__btns
          .instructions__btns-box
              a(href="/instructions/open-vpn/windows/" class="btn  btn-white")
                  .text Windows
          .instructions__btns-box
              a(href="/instructions/open-vpn/iphone/" class="btn  btn-white")
                  .text iPhone
          .instructions__btns-box
              a(href="/instructions/open-vpn/mac/" class="btn  btn-white")
                  .text macOS  
          .instructions__btns-box                      
              a(href="/instructions/open-vpn/android/" class="btn  btn-white")
                  .text Android
          .instructions__btns-box
              a(href="/instructions/open-vpn/other/" class="btn  btn-white")
                  .text Другое            

        




