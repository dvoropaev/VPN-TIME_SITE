extends ../../../layouts/_layout.pug

block vars
  - var basePath = '../../'
  - var bodyClass = 'page-instructions'
  - var currentPage = 'instructions'

block title
  title Инструкции OpenVPN

block content
  main
    .content
      section.instructions-hero
        .hero__bg-trees
        .hero__bg-server
        .container
          .instructions-hero__image


      .container

        .instructions__btns
          .instructions__btns-box
              a(href="./windows/" class="btn  btn-white")
