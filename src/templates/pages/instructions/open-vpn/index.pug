          .instructions__btns-box
              a(href="./iphone/" class="btn  btn-white")
                  .text iPhone
          .instructions__btns-box
              a(href="./mac/" class="btn  btn-white")
                  .text macOS  
          .instructions__btns-box                      
              a(href="./android/" class="btn  btn-white")
                  .text Android
          .instructions__btns-box
              a(href="./other/" class="btn  btn-white")
                  .text Другое            

        




