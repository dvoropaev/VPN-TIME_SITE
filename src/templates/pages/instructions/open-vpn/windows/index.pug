extends ../../../../layouts/_layout.pug

block vars
  - var basePath = '../../../'
  - var bodyClass = 'page-instructions-windows'
  - var currentPage = 'instructions-windows'

block title
  title Настройка на Windows

block content
  main
    section.hero
      .hero__bg-trees
      .container
        .instructions-windows-hero__image


    .container
      .instructions-mac__info
        .title Настройка на Windows
        .instructions-mac__info-content
            p Скачайте и установите приложение <a href="https://openvpn.net/client/" target="_blank">OpenVPN Connect</a>.
            p После успешной установки у вас должен появиться ярлык на рабочем столе:
            .img__box.win-1
              img(src="../../../img/page/instructions/ovpn/windows/openVPN.jpg", alt="")
              
      .instructions-mac__info
        .instructions-mac__info-content
            p Зайдите в телеграм бот и сохраните сгенерированный ключ в любом месте
            p Запустите OpenVPN Connect. Нажмите UPLOAD FILE.
            p В появившуюся область перетащите скачанный ранее файл с ключом

            .img__box.win-2
              img(src="../../../img/page/instructions/ovpn/windows/win2.jpg", alt="")         

      .instructions-mac__info
        .instructions-mac__info-content
            p Используйте ползунок для включения/выключения VPN
            p Окно можно закрыть, VPN продолжит работать

            .img__box.win-3
              img(src="../../../img/page/instructions/ovpn/windows/win3.jpg", alt="")  


      .instructions-mac__info
        .instructions-mac__info-content
            p Чтобы вернуться к управлению VPN нужно найти значок OpenVPN в нижней правой панели

            .img__box.win-4
              img(src="../../../img/page/instructions/ovpn/windows/win4.jpg", alt="")  

    //-
      .box__btn
        a(href="https://t.me/vpn_time_support" class="btn btn-blue" target="_blank")
          span.icon.icon-telegram
          .text связаться с нами
      
