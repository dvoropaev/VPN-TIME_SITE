extends ../../../../layouts/_layout.pug

block vars
  - var basePath = '/'
  - var bodyClass = 'page-instructions-mac'
  - var currentPage = 'instructions-mac'
  - var canonicalPath = '/instructions/open-vpn/mac/'

block structuredData
  script(type='application/ld+json').
    {
      "@context": "https://schema.org",
      "@type": "HowTo",
      "name": "Настройка OpenVPN на macOS",
      "description": "Базовые шаги по настройке OpenVPN Connect на macOS через ключ из Telegram-бота.",
      "inLanguage": "ru-RU",
      "url": "https://vtime.pro/instructions/open-vpn/mac/",
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Установить OpenVPN Connect."
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "Сгенерировать и скачать файл ключа."
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "Открыть файл ключа в приложении."
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "name": "Включить VPN через интерфейс OpenVPN Connect."
        }
      ]
    }

block title
  title Настройка на macOS

block content
  main
    section.hero
      .hero__bg-trees
      .container
        .instructions-mac-hero__image

    .container
      .instructions-mac__info
        .title Настройка на macOS
        .instructions-mac__info-content
            p Инструкция для настройки VPN на MacBook ещё не готова :( 
            p Приносим свои извинения...

            ul 
                li Но вы можете попробовать следующее:
                li Скачайте и установите приложение OpenVPN Connect .
                li Сгенерируйте и скачайте файл с ключом в нашем боте
                li Откройте полученный файл в приложении OpenVPN Connect
                li Используйте ползунок для включения/выключения VPN
                li Если не получилось - напишите нам!



    //-
      .box__btn
        a(href="https://t.me/vpn_time_support" class="btn btn-blue" target="_blank")
          span.icon.icon-telegram
          .text связаться с нами
      
