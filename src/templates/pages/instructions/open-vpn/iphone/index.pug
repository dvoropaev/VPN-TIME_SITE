extends ../../../../layouts/_layout.pug

block vars
  - var basePath = '/'
  - var bodyClass = 'page-instructions-iphone'
  - var currentPage = 'instructions-iphone'
  - var canonicalPath = '/instructions/open-vpn/iphone/'

block title
  title Настройка на iPhone

block content
  main
    section.hero
      .hero__bg-trees
      .container
        .instructions-iphone-hero__image

    .container
      .instructions-mac__info
        .title Настройка на iPhone
        .instructions-mac__info-content
            p Установите 
              a(href="") OpenVPN Connect.
            p При первом запуске у вас спросят разрешение на показ уведомления (тут лучше согласиться: рекламы не будет, честно-честно).
            p Также попросят согласиться с условиями использования (увы, тут выбора нет).
            .img__box.iphone-1
              img(src="/img/page/instructions/ovpn/iphone/iphone-1.jpg", alt="")

      .instructions-mac__info
        .instructions-mac__info-content
            p Зайдите в телеграм бота, найдите сообщение с файлом ключа и нажмите на файл чтобы открыть
            .img__box.iphone-2
              img(src="/img/page/instructions/ovpn/iphone/iphone-2.jpg", alt="")

      .instructions-mac__info
        .instructions-mac__info-content
            p В правом нижнем углу нажмите кнопку импорта файла
            .img__box.iphone-3
              img(src="/img/page/instructions/ovpn/iphone/iphone-3.jpg", alt="")

      .instructions-mac__info
        .instructions-mac__info-content
            p Вам будет предложено выбрать программу для открытия файла.
            p Найдите и выберите OpenVPN.
            .img__box.iphone-4
              img(src="/img/page/instructions/ovpn/iphone/iphone-4.jpg", alt="")

      .instructions-mac__info
        .instructions-mac__info-content
            p В появившемся окне нажмите Add.
            p Затем нажмите CONNECT.
            p Подтвердите все разрешения


      .instructions-mac__info
        .instructions-mac__info-content
            p Чтобы включать/выключать VPN, двигайте этот ползунок.
            p Если всплывет окно, нажмите Don't show again, а затем CONFIRM.
            .img__box.iphone-5
              img(src="/img/page/instructions/ovpn/iphone/iphone-5.jpg", alt="")

      .instructions-mac__info
        .instructions-mac__info-content
            p Можно настроить автоматическое отключение/включение VPN при отключении/включении экрана.
            p Это позволит экономить не только заряд, но и ваш баланс и нашу пропускную способность.
            p 
              span.text-700 ПРЕДУПРЕЖДЕНИЕ: 
              | С этой настройкой при частом включении/выключении экрана может происходить задержка при переподключении к VPN от нескольких секунд до 1 минуты.
            .img__box.iphone-6
              img(src="/img/page/instructions/ovpn/iphone/iphone-6.jpg", alt="")

      .instructions-mac__info
        .instructions-mac__info-content
            p Перейдите во вкладку 
              span.text-700 Settings
            p Поставьте галочку напротив пункта 
              span.text-700 Battery Saver
            .img__box.iphone-7
              img(src="/img/page/instructions/ovpn/iphone/iphone-7.jpg", alt="")              


    //-
      .box__btn
        a(href="https://t.me/vpn_time_support" class="btn btn-blue" target="_blank")
          span.icon.icon-telegram
          .text связаться с нами
      
