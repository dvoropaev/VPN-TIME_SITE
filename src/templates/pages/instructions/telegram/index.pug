extends ../../../layouts/_layout.pug

block vars
  - var basePath = '/'
  - var bodyClass = 'page-instructions'
  - var currentPage = 'instructions-telegram'
  - var canonicalPath = '/instructions/telegram'

block structuredData
  script(type='application/ld+json').
    {

    }

block title
  title Подключение к telegram-proxy

block content
  main
    .content
      section.instructions-hero
        .hero__bg-trees
        .hero__bg-server
        .container
          .instructions-hero__image

      .container
        .instructions__info
          .instructions__info-wrapper
            .title что  такое telegram-proxy?
            .instructions__info-content
              p(style="color: #d32f2f; font-style: italic;")
                strong Перед подключением обязательно прочитайте данную страницу до конца.
              p
                strong Telegram-proxy
                |  — это специальный прокси только для Telegram.
              p Работает быстрее и стабильнее для мессенджера, чем обычные VPN.
              p В отличие от VPN, не меняет весь интернет-трафик и используется только внутри Telegram.
              p
                strong Использование Telegram-proxy бесплатно.
              p
                strong Как подключиться:
              ul
                li Откройте эту страницу на устройстве, которое хотите подключить.
                li Нажмите кнопку «Подключить» к одному из серверов.
                li Подтвердите подключение в Telegram.
                li Если не получилось - попробуйте подключиться к другому серверу.
            div.instructions__info-btn(style="margin-top: 12px;")
              a(href="tg://proxy?server=prof-tmtpol-free.vtime.pro&port=443&secret=ee70f54e1caa93425dfadd1584b6a60bcb7674696d652e70726f" class="btn btn-green"  style="width: 190px; justify-content: center;")
                span.text Польша
            div.instructions__info-btn(style="margin-top: 12px;")
              a(href="tg://proxy?server=hsts-tmt-free.vtime.pro&port=443&secret=ee70f54e1caa93425dfadd1584b6a60bcb7674696d652e70726f" class="btn btn-green"  style="width: 190px; justify-content: center;")
                span.text Германия
            div.instructions__info-btn(style="margin-top: 12px;")
              a(href="tg://proxy?server=vdsinc-tmt-free.vtime.pro&port=443&secret=ee70f54e1caa93425dfadd1584b6a60bcb7674696d652e70726f" class="btn btn-green"  style="width: 190px; justify-content: center;")
                span.text Нидерланды




      .container
        .instructions__info
          .instructions__info-wrapper
            .title ВАЖНО
            .instructions__info-content
              p
                strong Telegram-proxy не работает вместе с включённым VPN
                |  — они конфликтуют.
              p
                strong Что можно сделать:
              ul
                li Отключать VPN при использовании Telegram
                li Если используете happ — настройте Telegram в обход VPN (split tunneling)

      .container
        .instructions__info
          .instructions__info-wrapper
            .title Если что-то пошло не так
            .instructions__info-content
              p
                strong Отключите прокси в Telegram:
              ul
                li Зайдите в настройки.
                li Найдите «Proxy settings».
                li Выключите «Use proxy».
              p
                strong Если используете Telegram на компьютере:
              ul
                li Откройте «Продвинутые соединения».
                li Выберите «Использовать системный прокси».
              p(style="color: #d32f2f; font-style: italic;")
                strong Сохраните эту страницу в закладки:
                |  здесь информация и ссылка для подключения будут периодически обновляться.



