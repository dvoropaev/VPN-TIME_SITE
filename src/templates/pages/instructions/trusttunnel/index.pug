extends ../../../layouts/_layout.pug

block vars
  - var basePath = '/'
  - var bodyClass = 'page-instructions'
  - var currentPage = 'instructions'
  - var canonicalPath = '/instructions/trusttunnel/'

block structuredData
  script(type='application/ld+json').
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": "Инструкции TrustTunnel",
      "url": "https://vtime.pro/instructions/trusttunnel/",
      "description": "Страница выбора инструкций по настройке протокола TrustTunnel на разных устройствах.",
      "inLanguage": "ru-RU",
      "about": {
        "@type": "Thing",
        "name": "TrustTunnel"
      }
    }

block title
  title Инструкции TrustTunnel

block content
  main
    .content
      section.instructions-hero
        .hero__bg-trees
        .hero__bg-server
        .container
          .instructions-hero__image


      .container

        .instructions__btns
          .instructions__btns-box
              a(href="/instructions/trusttunnel/windows/" class="btn  btn-white")
                  .text Windows
          .instructions__btns-box
              a(href="/instructions/trusttunnel/iphone/" class="btn  btn-white")
                  .text iPhone
          .instructions__btns-box
              a(href="/instructions/trusttunnel/mac/" class="btn  btn-white")
                  .text macOS  
          .instructions__btns-box                      
              a(href="/instructions/trusttunnel/android/" class="btn  btn-white")
                  .text Android
          .instructions__btns-box
              a(href="/instructions/trusttunnel/other/" class="btn  btn-white")
                  .text Другое            

        




