extends ../../../../layouts/_layout.pug

block vars
  - var basePath = '/'
  - var bodyClass = 'page-instructions-other'
  - var currentPage = 'instructions-other'
  - var canonicalPath = '/instructions/trusttunnel/other/'

block structuredData
  script(type='application/ld+json').
    {
      "@context": "https://schema.org",
      "@type": "HowTo",
      "name": "Настройка TrustTunnel на других устройствах",
      "description": "Инструкция по подключению к VPN-TIME (TrustTunnel) на других устройствах.",
      "inLanguage": "ru-RU",
      "url": "https://vtime.pro/instructions/trusttunnel/other/",
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Открыть страницу инструкции."
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "Дождаться публикации полной пошаговой инструкции."
        }
      ]
    }

block title
  title Настройка на других устройствах 

block content
  main
    .content
      section.hero
        .hero__bg-trees
        .container
          .instructions-other-hero__image

