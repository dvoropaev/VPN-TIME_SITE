extends ../../../../layouts/_layout.pug

block vars
  - var basePath = '/'
  - var bodyClass = 'page-instructions-android'
  - var currentPage = 'instructions-android'
  - var canonicalPath = '/instructions/trusttunnel/android/'

block structuredData
  script(type='application/ld+json').
    {
      "@context": "https://schema.org",
      "@type": "HowTo",
      "name": "Настройка TrustTunnel на Android",
      "description": "Инструкция по подключению к VPN-TIME (TrustTunnel) на Android.",
      "inLanguage": "ru-RU",
      "url": "https://vtime.pro/instructions/trusttunnel/android/",
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Открыть страницу инструкции."
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "Дождаться публикации полной пошаговой инструкции."
        }
      ]
    }

block title
  title Настройка на Android

block content
  main
    .content
      section.hero
        .hero__bg-trees
        .container
          .instructions-android-hero__image

      .container
        .instructions-mac__info
          .title Настройка на Android
          .instructions-mac__info-content
              p Статья в процессе разработки!!!         

    //-
      .box__btn
        a(href="https://t.me/vpn_time_support" class="btn btn-blue" target="_blank")
          span.icon.icon-telegram
          .text связаться с нами
      
