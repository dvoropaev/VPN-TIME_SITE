extends ../../../../layouts/_layout.pug

block vars
  - var basePath = '/'
  - var bodyClass = 'page-instructions-iphone'
  - var currentPage = 'instructions-iphone'
  - var canonicalPath = '/instructions/trusttunnel/iphone/'

block structuredData
  script(type='application/ld+json').
    {
      "@context": "https://schema.org",
      "@type": "HowTo",
      "name": "Настройка TrustTunnel на iPhone",
      "description": "Инструкция по подключению к VPN-TIME (TrustTunnel) на iPhone.",
      "inLanguage": "ru-RU",
      "url": "https://vtime.pro/instructions/trusttunnel/iphone/",
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Открыть страницу инструкции."
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "Дождаться публикации полной пошаговой инструкции."
        }
      ]
    }

block title
  title Настройка на iPhone

block content
  main
    .content
      section.hero
        .hero__bg-trees
        .container
          .instructions-iphone-hero__image

      .container
        .instructions-mac__info
          .title Настройка TrustTunnel на iPhone
          .instructions-mac__info-content
              p Статья в процессе разработки!!!

        


    //-
      .box__btn
        a(href="https://t.me/vpn_time_support" class="btn btn-blue" target="_blank")
          span.icon.icon-telegram
          .text связаться с нами
      
