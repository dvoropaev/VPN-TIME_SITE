extends ../../../../layouts/_layout.pug

block vars
  - var basePath = '/'
  - var bodyClass = 'page-instructions-android'
  - var currentPage = 'instructions-android'
  - var canonicalPath = '/instructions/xray/android/'

block structuredData
  script(type='application/ld+json').
    {
      "@context": "https://schema.org",
      "@type": "HowTo",
      "name": "Настройка Xray на Android",
      "description": "Инструкция по подключению к VPN-TIME (Xray) на Android через HAPP.",
      "inLanguage": "ru-RU",
      "url": "https://vtime.pro/instructions/xray/android/",
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Скачать HAPP."
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "Создать Xray-ключ в боте и скопировать его."
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "Запустить HAPP и нажать на плюс."
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "name": "Выбрать добавление из буфера обмена."
        },
        {
          "@type": "HowToStep",
          "position": 5,
          "name": "Проверить список серверов."
        },
        {
          "@type": "HowToStep",
          "position": 6,
          "name": "Включать и выключать VPN большой кнопкой."
        },
        {
          "@type": "HowToStep",
          "position": 7,
          "name": "Регулярно обновлять список серверов."
        }
      ]
    }

block title
  title Настройка на Android

block content
  main
    .content
      section.hero
        .hero__bg-trees
        .container
          .instructions-android-hero__image

      .container
        .instructions-mac__info
          .title Настройка Xray на Android
          .instructions-mac__info-content
              p Скачайте и установите HAPP по одной из этих ссылок:
              p <a href="https://play.google.com/store/apps/details?id=com.happproxy" target="_blank">Play Market</a>.
              p <a href="https://github.com/Happ-proxy/happ-android/releases/latest/download/Happ.apk" target="_blank">Зеркало</a>.
          .img__box.win-2
              img(src="/img/page/instructions/xray/android/1.jpg", alt="Скачать HAPP для Android")

      .container
        .instructions-mac__info
          .instructions-mac__info-content
              p Если вы ещё не сделали Xray-ключ — зайдите в бота и сделайте новый ключ, указав тип подключения <b>"xray"</b>.
              p Скопируйте ключ из бота (он похож на URL).
          .img__box.win-2
              img(src="/img/page/instructions/xray/android/2.jpg", alt="Скопировать Xray-ключ из бота")

      .container
        .instructions-mac__info
          .instructions-mac__info-content
              p Запустите приложение HAPP и нажмите на плюс.
          .img__box.win-2
              img(src="/img/page/instructions/xray/android/3.jpg", alt="Нажать на плюс в HAPP")

      .container
        .instructions-mac__info
          .instructions-mac__info-content
              p Выберите пункт <b>"Из буфера обмена"</b>.
          .img__box.win-2
              img(src="/img/page/instructions/xray/android/4.jpg", alt="Выбрать импорт из буфера обмена")

      .container
        .instructions-mac__info
          .instructions-mac__info-content
              p Появится список серверов. Рекомендуем регулярно пробовать разные сервера, чтобы найти тот, который подходит вам больше всего.
          .img__box.win-2
              img(src="/img/page/instructions/xray/android/5.jpg", alt="Список серверов в HAPP")

      .container
        .instructions-mac__info
          .instructions-mac__info-content
              p Используйте большую кнопку для включения и выключения VPN.
          .img__box.win-2
              img(src="/img/page/instructions/xray/android/6.jpg", alt="Включить или выключить VPN в HAPP")

      .container
        .instructions-mac__info
          .instructions-mac__info-content
              p Регулярно нажимайте на кнопку обновления для получения актуального списка серверов.
          .img__box.win-2
              img(src="/img/page/instructions/xray/android/7.jpg", alt="Обновить список серверов в HAPP")

