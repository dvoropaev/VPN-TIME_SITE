extends ../../../../layouts/_layout.pug

block vars
  - var basePath = '/'
  - var bodyClass = 'page-instructions-android'
  - var currentPage = 'instructions-android'
  - var canonicalPath = '/instructions/xray/android/'

block structuredData
  script(type='application/ld+json').
    {
      "@context": "https://schema.org",
      "@type": "HowTo",
      "name": "Настройка Xray на Android",
      "description": "Пошаговая инструкция по настройке Hiddify и импорту Xray-ключа на Android.",
      "inLanguage": "ru-RU",
      "url": "https://vtime.pro/instructions/xray/android/",
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Установить Hiddify."
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "Создать Xray-ключ в боте."
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "Добавить ключ через буфер обмена."
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "name": "Подключиться и при необходимости выбрать другую локацию."
        }
      ]
    }

block title
  title Настройка на Android

block content
  main
    .content
      section.hero
        .hero__bg-trees
        .container
          .instructions-android-hero__image

      .container
        .instructions-mac__info
          .title Настройка Xray на Android
          .instructions-mac__info-content
              p Установите приложение Hiddify из:
              p <a href="https://play.google.com/store/search?q=hiddify&c=apps&hl=ru" target="_blank">Google Play</a>.
              p <a href="https://github.com/hiddify/hiddify-app/releases/download/v4.0.4/Hiddify-Android-universal.apk" target="_blank">Зеркало</a>.
          .img__box.win-2
              img(src="/img/page/instructions/xray/android/1.jpg", alt="")

      .container
        .instructions-mac__info
          // .title Настройка на Windows xray
          .instructions-mac__info-content
              p Нажмите на <b>"+"</b> чтобы добавить подключение.
          .img__box.win-2
              img(src="/img/page/instructions/xray/android/2.jpg", alt="")

      .container
        .instructions-mac__info
          // .title Настройка на Windows xray
          .instructions-mac__info-content
              p Если вы ещё не сделали Xray-ключ — зайдите в бота и сделайте новый ключ, указав тип подключения <b>"xray"</b>.
              p Скопируйте новый ключ из бота (он похож на URL)
          .img__box.win-2
              img(src="/img/page/instructions/xray/android/3.jpg", alt="")

      .container
        .instructions-mac__info
          // .title Настройка на Windows xray
          .instructions-mac__info-content
              p Вернитесь в Hiddify и вставьте URL из буфера обмена.
          .img__box.win-2
              img(src="/img/page/instructions/xray/android/4.jpg", alt="")

      .container
        .instructions-mac__info
          // .title Настройка на Windows xray
          .instructions-mac__info-content
              p Нажмите на большую круглую кнопку для подключения.
          .img__box.win-2
              img(src="/img/page/instructions/xray/android/5.jpg", alt="")

      .container
        .instructions-mac__info
          // .title Настройка на Windows xray
          .instructions-mac__info-content
              p Сервер и локация будут выбраны автоматически.
              p Для ручного выбора перейдите в меню "Прокси".
          .img__box.win-2
              img(src="/img/page/instructions/xray/android/6.jpg", alt="")

      .container
        .instructions-mac__info
          // .title Настройка на Windows xray
          .instructions-mac__info-content
              p Вы увидите список доступных локаций/серверов.
              p В случае возникновения проблем со скоростью/доступом рекомендуем попробовать разные сервера из этого списка.
          .img__box.win-2
              img(src="/img/page/instructions/xray/android/7.jpg", alt="")

      .container
        .instructions-mac__info
          // .title Настройка на Windows xray
          .instructions-mac__info-content
              p Рекомендуем регулярно нажимать на круглую стрелку, чтобы приложение обновляло список доступных серверов/локаций.
          .img__box.win-2
              img(src="/img/page/instructions/xray/android/8.jpg", alt="")

    //-
      .box__btn
        a(href="https://t.me/vpn_time_support" class="btn btn-blue" target="_blank")
          span.icon.icon-telegram
          .text связаться с нами
      
