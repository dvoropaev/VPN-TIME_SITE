extends ../../../../layouts/_layout.pug

block vars
  - var basePath = '/'
  - var bodyClass = 'page-instructions-iphone'
  - var currentPage = 'instructions-iphone'
  - var canonicalPath = '/instructions/xray/iphone/'

block structuredData
  script(type='application/ld+json').
    {
      "@context": "https://schema.org",
      "@type": "HowTo",
      "name": "Настройка Xray на iPhone",
      "description": "Пошаговая инструкция по настройке Hiddify и импорту Xray-ключа на iPhone.",
      "inLanguage": "ru-RU",
      "url": "https://vtime.pro/instructions/xray/iphone/",
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Установить Hiddify из App Store."
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "Создать Xray-ключ в боте."
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "Добавить ключ в приложение."
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "name": "Подключиться и выбрать сервер при необходимости."
        }
      ]
    }

block title
  title Настройка на iPhone

block content
  main
    .content
      section.hero
        .hero__bg-trees
        .container
          .instructions-iphone-hero__image

      .container
        .instructions-mac__info
          .title Настройка Xray на iPhone
          .instructions-mac__info-content
              p Установите приложение Hiddify из <a href="https://apps.apple.com/us/app/hiddify-proxy-vpn/id6596777532" target="_blank">App Store</a>.

      .container
        .instructions-mac__info
          // .title Настройка на Windows xray
          .instructions-mac__info-content
              p Нажмите на <b>"+"</b> чтобы добавить подключение.
          .img__box.win-2
              img(src="/img/page/instructions/xray/android/2.jpg", alt="")

      .container
        .instructions-mac__info
          // .title Настройка на Windows xray
          .instructions-mac__info-content
              p Если вы ещё не сделали Xray-ключ — зайдите в бота и сделайте новый ключ, указав тип подключения <b>"xray"</b>.
              p Скопируйте новый ключ из бота (он похож на URL)
          .img__box.win-2
              img(src="/img/page/instructions/xray/android/3.jpg", alt="")

      .container
        .instructions-mac__info
          // .title Настройка на Windows xray
          .instructions-mac__info-content
              p Вернитесь в Hiddify и вставьте URL из буфера обмена.
          .img__box.win-2
              img(src="/img/page/instructions/xray/android/4.jpg", alt="")

      .container
        .instructions-mac__info
          // .title Настройка на Windows xray
          .instructions-mac__info-content
              p Нажмите на большую круглую кнопку для подключения.
          .img__box.win-2
              img(src="/img/page/instructions/xray/android/5.jpg", alt="")

      .container
        .instructions-mac__info
          // .title Настройка на Windows xray
          .instructions-mac__info-content
              p Сервер и локация будут выбраны автоматически.
              p Для ручного выбора перейдите в меню "Прокси".
          .img__box.win-2
              img(src="/img/page/instructions/xray/android/6.jpg", alt="")

      .container
        .instructions-mac__info
          // .title Настройка на Windows xray
          .instructions-mac__info-content
              p Вы увидите список доступных локаций/серверов.
              p В случае возникновения проблем со скоростью/доступом рекомендуем попробовать разные сервера из этого списка.
          .img__box.win-2
              img(src="/img/page/instructions/xray/android/7.jpg", alt="")

      .container
        .instructions-mac__info
          // .title Настройка на Windows xray
          .instructions-mac__info-content
              p Рекомендуем регулярно нажимать на круглую стрелку, чтобы приложение обновляло список доступных серверов/локаций.
          .img__box.win-2
              img(src="/img/page/instructions/xray/android/8.jpg", alt="")

        


