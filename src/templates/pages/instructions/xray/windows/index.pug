extends ../../../../layouts/_layout.pug

block vars
  - var basePath = '/'
  - var bodyClass = 'page-instructions-windows'
  - var currentPage = 'instructions-windows'
  - var canonicalPath = '/instructions/xray/windows/'

block structuredData
  script(type='application/ld+json').
    {
      "@context": "https://schema.org",
      "@type": "HowTo",
      "name": "Настройка Xray на Windows",
      "description": "Инструкция по подключению к VPN-TIME (Xray) на Windows.",
      "inLanguage": "ru-RU",
      "url": "https://vtime.pro/instructions/xray/windows/",
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Скачать и установить Happ."
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "Нажать «Установить»."
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "Создать и скопировать Xray-ключ в боте."
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "name": "Вставить Xray-ключ в Happ."
        },
        {
          "@type": "HowToStep",
          "position": 5,
          "name": "Подключиться."
        },
        {
          "@type": "HowToStep",
          "position": 6,
          "name": "Обновить список серверов и локаций."
        }
      ]
    }

block title
  title Настройка на Windows

block content
  main
    .content
      section.hero
        .hero__bg-trees
        .container
          .instructions-windows-hero__image


      .container
        .instructions-mac__info
          .title Настройка Xray на Windows
          .instructions-mac__info-content
              p Скачайте <a href="https://github.com/Happ-proxy/happ-desktop/releases/latest/download/setup-Happ.x64.exe" target="_blank">Happ</a> и запустите установку.
          .img__box.win-2
              img(src="/img/page/instructions/xray/windows/1.png", alt="")

      .container
        .instructions-mac__info
          // .title Настройка на Windows xray
          .instructions-mac__info-content
              p Нажмите <b>"установить"</b>.
          .img__box.win-2
              img(src="/img/page/instructions/xray/windows/2.png", alt="")

      .container
        .instructions-mac__info
          // .title Настройка на Windows xray
          .instructions-mac__info-content
              p Если вы ещё не сделали Xray-ключ — зайдите в бот и сделайте новый ключ, указав тип подключения <b>"xray"</b>.
              p Скопируйте новый ключ из бота (он похож на URL)
          .img__box.win-2
              img(src="/img/page/instructions/xray/windows/3.png", alt="")

      .container
        .instructions-mac__info
          // .title Настройка на Windows xray
          .instructions-mac__info-content
              p Запустите Happ и вставьте скопированный Xray-ключ в поле.
          .img__box.win-2
              img(src="/img/page/instructions/xray/windows/4.png", alt="")

      .container
        .instructions-mac__info
          // .title Настройка на Windows xray
          .instructions-mac__info-content
              p Нажмите на большую круглую кнопку для подключения.
          .img__box.win-2
              img(src="/img/page/instructions/xray/windows/5.png", alt="")

      .container
        .instructions-mac__info
          // .title Настройка на Windows xray
          .instructions-mac__info-content
              p Рекомендуем регулярно нажимать на круглую стрелку, чтобы приложение обновляло список доступных серверов/локаций.
          .img__box.win-2
              img(src="/img/page/instructions/xray/windows/6.png", alt="")





