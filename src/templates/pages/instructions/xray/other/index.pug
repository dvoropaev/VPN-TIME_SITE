extends ../../../../layouts/_layout.pug

block vars
  - var basePath = '/'
  - var bodyClass = 'page-instructions-other'
  - var currentPage = 'instructions-other'
  - var canonicalPath = '/instructions/xray/other/'

block structuredData
  script(type='application/ld+json').
    {
      "@context": "https://schema.org",
      "@type": "HowTo",
      "name": "Настройка Xray на других устройствах",
      "description": "Страница для дополнительных инструкций по настройке Xray на других устройствах.",
      "inLanguage": "ru-RU",
      "url": "https://vtime.pro/instructions/xray/other/",
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Открыть страницу с инструкцией."
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "Уточнить поддержку устройства."
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "Следовать будущим шагам после публикации инструкции."
        }
      ]
    }

block title
  title Настройка на других устройствах 

block content
  main
    .content
      section.hero
        .hero__bg-trees
        .container
          .instructions-other-hero__image

      .container
      
        .instructions-mac__info
          .title 
            div Настройка 
            div на других устройствах 
          .instructions-mac__info-content
              p Статья в процессе разработки!!!



