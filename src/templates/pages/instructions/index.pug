extends ../../layouts/_layout.pug

block vars
  - var basePath = '/'
  - var bodyClass = 'page-instructions'
  - var currentPage = 'instructions'
  - var canonicalPath = '/instructions/'

block structuredData
  script(type='application/ld+json').
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": "Инструкции VPN-TIME",
      "description": "Каталог инструкций по настройке Xray, OpenVPN и TrustTunnel для разных устройств.",
      "inLanguage": "ru-RU",
      "url": "https://vtime.pro/instructions/",
      "hasPart": [
        {
          "@type": "WebPage",
          "name": "Инструкции Xray",
          "url": "https://vtime.pro/instructions/xray/"
        },
        {
          "@type": "WebPage",
          "name": "Инструкции OpenVPN",
          "url": "https://vtime.pro/instructions/open-vpn/"
        },
        {
          "@type": "WebPage",
          "name": "Инструкции TrustTunnel",
          "url": "https://vtime.pro/instructions/trusttunnel/"
        }
      ]
    }

block title
  title Инструкции

block content
  main
    .content
      section.instructions-hero
        .hero__bg-trees
        .hero__bg-server
        .container
          .instructions-hero__image

      .container

        .instructions__info
          .instructions__info-wrapper
            .title Xray
            .instructions__info-content
              p Xray - современная технология обхода блокировок.
              p Поддерживаются следующие локации:
              .ico__text 
                span.flag.flag__netherlands
                | Нидерланды
              .ico__text 
                span.flag.flag__usa
                | США
              .ico__text 
                span.flag.flag__finland
                | Финляндия
              .ico__text 
                span.flag.flag__germany
                | Германия
              .ico__text 
                span.flag.flag__russia
                | Россия
              .ico__text
                span.flag.flag__pirate
                | Сервер, на котором разрешен торрент-трафик

            div.instructions__info-btn
              a(href="/instructions/xray/" class="btn btn-green")
                span.text Настроить Xray

        .instructions__info
          .instructions__info-wrapper
            .title OpenVPN
            .instructions__info-content
              p OpenVPN - устаревший метод обхода блокировок.
              p Поддерживаются следующие локации:
              .ico__text 
                span.flag.flag__netherlands
                | Нидерланды
              .ico__text 
                span.flag.flag__usa
                | США
              .ico__text 
                span.flag.flag__russia
                | Россия
              .ico__text
                span.flag.flag__pirate
                | Сервер, на котором разрешен торрент-трафик

            div.instructions__info-btn
              a(href="/instructions/open-vpn/" class="btn btn-green" )
                span.text Настроить OpenVPN

        .instructions__info
          .instructions__info-wrapper
            .title TrustTunnel
            .instructions__info-content
              p TrustTunnel - новый, экспериментальный протокол. Более устойчив к обнаружению и блокировкам.
              p <b> Находится в разработке. Мы прикладываем усилия, чтобы внедрить его как можно быстрее.</b>
            //  p Поддерживаются следующие локации:
            //   .ico__text
            //     span.flag.flag__netherlands
            //     | Нидерланды
            //
            // div.instructions__info-btn
            //   a(href="/instructions/trusttunnel/" class="btn btn-green" )
            //     span.text Настроить TrustTunnel

        




