extends ../../layouts/_layout.pug

block vars
  - var basePath = '../'
  - var bodyClass = 'page-instructions'
  - var currentPage = 'instructions'

block title
  title Правила

block content
  main
    .content
      section.instructions-hero
        .hero__bg-trees
        .hero__bg-server
        .container
          .instructions-hero__image

      .container

        .instructions__info
          .instructions__info-wrapper
            .title Xray
            .instructions__info-content
              p Xray - современная технология обхода блокировок.
              p Поддерживаются следующие локации:
              .ico__text 
                span.flag.flag__netherlands
                | Нидерланды
              .ico__text 
                span.flag.flag__usa
                | США
              .ico__text
                span.flag.flag__torrent
                | Сервер, на котором размещен торрент-трафик

            div.instructions__info-btn
              a(href="xray/" class="btn btn-green" target="_blank")
                span.text Настроить Xray

        .instructions__info
          .instructions__info-wrapper
            .title OpenVPN
            .instructions__info-content
              p OpenVPN - устаревший метод обхода блокировок.
              p Поддерживаются следующие локации:
              .ico__text 
                span.flag.flag__netherlands
                | Нидерланды
              .ico__text 
                span.flag.flag__usa
                | США
              .ico__text
                span.flag.flag__torrent
                | Сервер, на котором размещен торрент-трафик

            div.instructions__info-btn
              a(href="open-vpn/" class="btn btn-green" )
                span.text Настроить OpenVPN              

        




    .box__btn
      a(href="https://t.me/vpn_time_support" class="btn btn-blue" target="_blank")
        span.icon.icon-telegram
        .text связаться с нами
