- 
  var basePath = typeof basePath !== 'undefined' ? basePath : './'
  var mainMenu = [
    {
      "name": "Главная",
      "link": basePath === './' ? './' : '../'
    },
    {
      "name": "Faq",
      "link": basePath + "faq/"
    },
    {
      "name": "Правила",
      "link": basePath + "rules/"
    },
    {
      "name": "Инструкции",
      "link": basePath + "instructions/"
    },
    {
      "name": "Мерч",
      "link": basePath + "merch/"
    }
  ];

<header id="header" class="header">
  <div class="container">
    <nav class="header__nav">

      each nav in mainMenu
          a(
              href=nav.link
              class="header__nav-item" +
              (active_nav == nav.link ? ' active' : '')
          )= nav.name

    </nav>
  </div>
</header>