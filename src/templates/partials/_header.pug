- 
  var mainMenu = [
    {
      "name": "Главная",
      "link": "/"
    },
    {
      "name": "Faq",
      "link": "/faq"
    },
    {
      "name": "Правила",
      "link": "/rules"
    },
    {
      "name": "Инструкции",
      "link": "/instructions"
    },
    {
      "name": "Мерч",
      "link": "/merch"
    }
  ];

<header id="header" class="header">
  <div class="container">
    <nav class="header__nav">

      each nav in mainMenu
          a(
              href=nav.link
              class="header__nav-item" +
              (active_nav == nav.link ? ' active' : '')
          )= nav.name

    </nav>
  </div>
</header>